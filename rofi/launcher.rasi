* {
    font: "monospace 10";
    foreground: #4169e1;
    background-color: transparent;
    border-size: 0;
    border-radius: 0;
    padding: 0;
    margin: 0;
}

window {
    width: 245px;
    padding: 45px;
    x-offset: 120px;
    background-image: url("/home/arch/.config/rofi/bg.png", both);
    background-color: rgba ( 0, 0, 0, 0 % );
    border-color: #334466;
    border-size: 1;
    border-radius: 16px;
}

mainbox {
    padding: 0;
}

prompt {
    enabled: false;
}

inputbar {
    padding: 8px 12px;
    background-color: rgba ( 0, 0, 0, 40 % );
    border-radius: 8px;
    margin: 0 0 6px 0;
}

entry {
    background-color: transparent;
    placeholder: "search...";
    placeholder-color: #565f89;
    text-color: #4169e1;
    caret-color: #4169e1;
}

listview {
    lines: 4;
    columns: 2;
    spacing: 6px;
    padding: 6px;
    background-color: rgba ( 0, 0, 0, 40 % );
    border-radius: 8px;
}

element {
    padding: 6px 8px;
    background-color: transparent;
    border-radius: 6px;
}

element selected {
    background-color: rgba ( 122, 162, 247, 30 % );
    text-color: #7aa2f7;
}

element-icon {
    size: 1em;
    margin: 0 6px 0 0;
}

element-text {
    text-color: #8aa9f0;
    background-color: transparent;
}
